# 이 파일은 ".env에 무엇을 적어야 하는지" 알려 주는 안내서예요 (git에 올라가요)
# 쓰는 법: 이 파일을 복사해서 이름을 .env로 바꾸고, = 뒤에 실제 값을 채워 주세요
# 진짜 값은 .env에만 적어요. 여기에는 절대 적지 마세요!

# [필수] 세션·flash에 도장을 찍는 비밀 열쇠예요. 남이 맞힐 수 없는 긴 무작위 글자를 넣어요
# 만드는 법: python -c "import secrets; print(secrets.token_hex(32))"
# 비어 있으면 서버가 켜지지 않아요. 바꾸면 기존 찜 목록(세션)은 모두 초기화돼요
SECRET_KEY=

# [선택] 1이면 debug 모드가 켜져요 (코드 고치면 자동 재시작 + 에러 상세 화면)
# 내 컴퓨터에서만 1로 두고, 배포 서버에서는 적지 않거나 0으로 두세요
FLASK_DEBUG=
